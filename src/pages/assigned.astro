---
import getDate from "@functions/GetDate";
import { isDbError } from "astro:db";
import Layout from "src/layouts/Layout.astro";
import { turso } from "src/turso";

const pcName = Astro.url.searchParams.get("pcName");
const area = Astro.url.searchParams.get("area");
const userID = Astro.url.searchParams.get("userID");
const pcID = Astro.url.searchParams.get("pcID");
const fecha = getDate();

const { rows } = await turso.execute(
  "SELECT MAX(id) as maxID FROM Registers"
);
const nextID = Number(rows[0].maxID ?? 0) + 1;

// Detectar si es profesor o estudiante
let user: any[] = [];
if (typeof userID === "string" && userID.toLowerCase().startsWith("e")) {
  const { rows: prof } = await turso.execute(
    `SELECT * FROM Professors WHERE id = '${userID}'`
  );
  user = prof;
} else if (typeof userID === "string") {
  const { rows: stud } = await turso.execute(
    `SELECT * FROM User WHERE id = ${Number(userID)}`
  );
  user = stud;
}

// Obtener área y pc
const { rows: areaSel } = await turso.execute(
  `SELECT * FROM Area WHERE name = '${String(area)}'`
);
const { rows: pc } = await turso.execute(
  `SELECT * FROM PC WHERE id = ${Number(pcID)} AND name = '${String(pcName)}'`
);

if (
  typeof pcName === "string" &&
  typeof area === "string" &&
  typeof userID === "string" &&
  user.length > 0
) {
  try {
    await turso.execute(`
      INSERT INTO Registers (id, areaID, userID, pcID, statusID, _createdAt)
      VALUES (
        ${Number(nextID)},
        ${Number(areaSel[0].id)},
        '${user[0].id}',
        ${Number(pc[0].id)},
        3,
        '${fecha}'
      )
    `);
  } catch (e: any) {
    if (isDbError(e)) {
      console.error(
        `No se puede insertar un registro con nombre ${pcName}\n\n${e.message}`
      );
    } else {
      console.error(`Se ha producido un error inesperado\n\n${e.message}`);
    }
  }
}

// Obtener nombre (estudiante usa fullName, profesor usa fullname)
const displayName = user[0]?.fullName ?? user[0]?.fullname ?? "Usuario";
---

<Layout title="Has sido asignad@!">
  <div
    class="flex items-center justify-center flex-col mt-36 max-w-screen-xl mx-auto px-4 md:px-8 md:flex"
  >
    <h2 class="text-5xl dark:text-white font-bold mb-4">{displayName}</h2>
    <p class="text-xl dark:text-gray-300 font-bold mb-4">
      Se te asignó:
      <p
        class="text-5xl border border-LegacyBlue-500 rounded-lg p-4 dark:text-white font-bold mb-4"
      >
        {pcName}
      </p>
    </p>
    <p class="text-xl dark:text-gray-300 font-bold mb-4">
      En:
      <p
        class="text-5xl border border-LegacyBlue-500 rounded-lg p-4 dark:text-white font-bold mb-4"
      >
        {area}
      </p>
    </p>
  </div>
</Layout>
<script type="module" is:inline>
  setTimeout(() => {
    location.href = "/";
  }, 2500); // 5000 milisegundos = 5 segundos
</script>
