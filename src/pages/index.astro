---
import Form from "@form/Form.astro";
import FormInput from "@form/FormInput.astro";
import SubmitBtn from "@components/ui/Buttons/SubmitBtn.astro";
import FormSelect from "@components/ui/Forms/FormSelect.astro";
import SelectOption from "@components/ui/Forms/SelectOption.astro";
import searchPC from "@functions/SearchPC";
import { verifyUser, userHasSession, verifyProfessor } from "@functions/verifyUser";
import type { InputFieldArr } from "@customTypes/InputType";
import { turso } from "src/turso";
import getDate from "@functions/GetDate";
import Layout from "src/layouts/Layout.astro";

const inputs: InputFieldArr[] = [
  {
    name: "userID",
    label: "Matrícula",
    type: "text",
    isRequired: true,
    placeholder: "20104769",
  },
];

const { rows } = await turso.execute(`SELECT * FROM Area`);
const areas = rows;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const userIDRaw = formData.get("userID");
  const fareaID = formData.get("areaID");
  const date = getDate();

  if (typeof userIDRaw === "string" && typeof fareaID === "string") {
    const userIDStr = userIDRaw.trim();
    let numericUserID: number | null = null;
    let isProfessorID = false;

    // Detectar si es un ID de profesor que empieza con "E"
    if (userIDStr.toLowerCase().startsWith("e")) {
      isProfessorID = true;
    } else {
      numericUserID = Number(userIDStr);
    }

    // Verificar si el usuario existe
    const isUser = numericUserID !== null ? await verifyUser(numericUserID) : false;
    const isProfessor = isProfessorID || await verifyProfessor(userIDStr);

    if (!isUser && !isProfessor) {
      return Astro.redirect("/register");
    }

    const assignedID = numericUserID !== null ? numericUserID : `'${userIDStr}'`;

    // Liberar sesión si el usuario ya tiene un PC asignado
    if (numericUserID !== null ? await userHasSession(numericUserID) : false) {
      await turso.execute(`
        UPDATE PC SET statusID = 1, userID = NULL WHERE userID == ${numericUserID};
      `);
      await turso.execute(`
        UPDATE Registers 
        SET statusID = 1,
            userID = ${numericUserID},
            _updatedAt = '${date}'
        WHERE userID = ${numericUserID} AND statusID = 3;
      `);

      return new Response(
        `<script>
          alert("La sesión de ${userIDStr} ha sido terminada. Ahora puedes asignarte otra PC.");
          window.location.href = "/";
        </script>`,
        { headers: { "Content-Type": "text/html" } }
      );
    }

    // Asignación de PC
    try {
      const search = await searchPC(Number(fareaID));
      const { id, name, areaID } = search[0];
      const area = areas.find((room) => room.id === areaID)?.name;

      await turso.execute(`
        UPDATE PC SET statusID = 3, userID = ${assignedID} WHERE id = ${id};
      `);

      return Astro.redirect(
        `/assigned?pcName=${name}&area=${area}&userID=${userIDStr}&pcID=${id}`
      );
    } catch (e: any) {
      console.error(`No se puede asignar un PC a ${userIDStr}\n\nError: ${e.message}`);
      return new Response(
        `<script>
          alert("No se puede asignar un PC a ${userIDStr}");
          window.location.href = "/";
        </script>`,
        { headers: { "Content-Type": "text/html" } }
      );
    }
  }
}
---

<Layout title="Asignación de PC">
  <div
    class="flex items-center justify-center flex-col mt-36 max-w-screen-xl mx-auto px-4 md:px-8 md:flex"
  >
    <Form title="Asignación de PC">
      {
        inputs.map((inp) => (
          <FormInput
            name={inp.name}
            type={inp.type}
            isRequired
            placeholder={inp.placeholder}
          >
            {inp.label}
          </FormInput>
        ))
      }
      <FormSelect title="Selecciona Sala" name="areaID">
        <SelectOption isSelected value="">--Selecciona una Sala--</SelectOption>
        {
          areas?.map((area) => (
            <SelectOption value={area.id ? area.id?.toString() : ""}>
              {area.name}
            </SelectOption>
          ))
        }
      </FormSelect>
      <div class="flex justify-center items-center min-w-full mt-2">
        <SubmitBtn> Buscar </SubmitBtn>
      </div>
    </Form>
    <div class="dark:text-white">
      ¿No estas registrado? <a href="/register" class="text-LegacyBlue-600"
        >¡Registrate!</a
      >
    </div>
    <div class="dark:text-white">
      Si eres profesor registrate <a href="/professor/add" class="text-LegacyBlue-600"
        >¡Aquí!</a
      >
    </div>
  </div>
</Layout>
