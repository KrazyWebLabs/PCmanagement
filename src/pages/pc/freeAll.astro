---
import getDate from "@functions/GetDate";
import { turso } from "src/turso";
const date = getDate();

await turso.execute(`
  UPDATE PC
  SET statusID = 1,
    userID = null
  WHERE statusID != 1
`);

await turso.execute(`
  UPDATE Registers 
  SET statusID = 1,
    _updatedAt = '${date}'
  WHERE statusID = 3;
`);

return Astro.redirect("/pc");
---
