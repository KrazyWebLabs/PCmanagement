---
interface Props {
  title: string;
  method?: string;
}


const { title, method } = Astro.props;
---

<form class="max-w-full mx-auto p-4 grid grid-cols-2 md:grid-cols-1 gap-2 backdrop-blur-sm mt-16" method={method ?? "POST"}>
  <h2 class="text-5xl dark:text-white font-bold mb-4">{ title }</h2>
  <slot/>
</form>